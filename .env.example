# Copy to .env. The application boots WITHOUT this file (auth is optional).

# Set to true to activate the JWT auth snippet (POST /auth/login).
# When false (default), JWT_SECRET / BASE_URL are not required.
AUTH_ENABLED=false

# Required only when AUTH_ENABLED=true.
# Generate a strong secret:  openssl rand -base64 48
JWT_SECRET=

# Full URL of this service, including scheme. Used as the JWT issuer claim.
BASE_URL=http://localhost:8080